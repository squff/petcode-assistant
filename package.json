{
  "name": "petcode-assistant",
  "version": "1.0.0",
  "description": "AI Desktop Pet Assistant - 桌面AI萌宠助手",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.ts\" \"node scripts/wait-and-launch.js\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "node scripts/wait-and-launch.js",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc --project tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.petcode.assistant",
    "productName": "PetCode Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "open",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  }
}
